# MedRisk — example configuration. Copy to `.env` and fill in real values.
# The real `.env` is git-ignored and must never be committed (repo rule, step 4).
#   cp .env.example .env
#
# --- Database (PostgreSQL 15) ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medrisk
POSTGRES_USER=medrisk
POSTGRES_PASSWORD=change-me
# SQLite is used for local development/tests when DATABASE_URL is unset
DATABASE_URL=postgresql+psycopg://medrisk:change-me@localhost:5432/medrisk

# --- API (FastAPI) ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontend (React + Vite) ----------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- ML --------------------------------------------------------------------
ML_MODEL_PATH=models/risk_model.joblib

%% MedRisk — ER diagram (logical data model)
%% Editable source: render with `mmdc` or scripts/render-diagrams.sh
erDiagram
    USER ||--o{ ASSESSMENT : "submits"
    USER ||--|| AUTH_ACCOUNT : "owns"
    ASSESSMENT ||--|{ ANSWER : "contains"
    ASSESSMENT ||--o{ RISK_RESULT : "produces"
    RISK_RESULT ||--o{ FACTOR_CONTRIBUTION : "explains"
    MODEL_VERSION ||--o{ RISK_RESULT : "generated by"

    AUTH_ACCOUNT {
        bigint id PK
        varchar email UK
        varchar password_hash
        varchar role "user | admin"
        timestamptz created_at
    }
    USER {
        bigint id PK
        bigint account_id FK "nullable for guests"
        varchar anonymous_session_id UK "guest mode"
        date birth_date
        varchar sex
        varchar language "en | ru | kz"
    }
    ASSESSMENT {
        bigint id PK
        bigint user_id FK
        timestamptz created_at
        jsonb questionnaire_snapshot "auditability"
        varchar status "completed | error"
    }
    ANSWER {
        bigint id PK
        bigint assessment_id FK
        varchar feature_name
        numeric value
    }
    RISK_RESULT {
        bigint id PK
        bigint assessment_id FK
        bigint model_version_id FK "NFR-08 auditability"
        varchar target "cvd | t2d"
        numeric probability "0..1"
        varchar category "low | moderate | high | very_high"
        text disclaimer "NFR-06"
    }
    FACTOR_CONTRIBUTION {
        bigint id PK
        bigint risk_result_id FK
        varchar feature_name
        numeric shap_value "signed"
        int rank "by |shap|"
        text user_text "plain-language template"
    }
    MODEL_VERSION {
        bigint id PK
        varchar version "semver"
        varchar target "cvd | t2d"
        varchar algorithm "logreg | lightgbm"
        varchar training_data "dataset names"
        jsonb metrics "auc, brier, per-subgroup"
        timestamptz trained_at
        bool is_active
    }
